/* 我的页面样式 */
.container {
  padding: 20rpx;
}

/* 用户信息卡片 */
.user-card {
  background-color: #1aad19;
  border-radius: 12rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 30rpx;
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(26, 173, 25, 0.2);
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  background-color: #fff;
  border: 4rpx solid rgba(255, 255, 255, 0.6);
}

.user-detail {
  margin-left: 30rpx;
}

.nickname {
  font-size: 36rpx;
  font-weight: 500;
  margin-bottom: 10rpx;
  display: block;
}

.user-data {
  font-size: 28rpx;
  opacity: 0.9;
}

.user-info-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.login-btn-container {
  margin-top: 20rpx;
}

.login-btn {
  background-color: #fff;
  color: #1aad19;
  font-size: 28rpx;
  padding: 10rpx 40rpx;
  border-radius: 40rpx;
  border: none;
  font-weight: 500;
}

/* 营养目标卡片 */
.nutrition-card {
  margin-bottom: 30rpx;
}

.nutrition-goals {
  display: flex;
  flex-wrap: wrap;
  margin: 20rpx 0;
}

.nutrition-item {
  width: 50%;
  padding: 16rpx 0;
  box-sizing: border-box;
}

.nutrition-label {
  font-size: 28rpx;
  color: #666;
  margin-right: 20rpx;
}

.nutrition-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.nutrition-tips {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid #f0f0f0;
}

/* 设置列表 */
.settings-card {
  margin-bottom: 30rpx;
}

.settings-list {
  padding: 10rpx 0;
}

.settings-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.settings-item:last-child {
  border-bottom: none;
}

.settings-item-left {
  display: flex;
  align-items: center;
}

.settings-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
}

.settings-text {
  font-size: 30rpx;
  color: #333;
}

.arrow-icon {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.5;
}

/* 退出登录按钮 */
.logout-container {
  margin: 40rpx 0;
}

.logout-btn {
  background-color: #f5f5f5;
  color: #ff4d4f;
  font-size: 30rpx;
  border: none;
}

/* 版本信息 */
.version-info {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  margin: 40rpx 0;
} 